# --- Supabase (from `npx supabase start` or your project's API settings) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used for ingestion and admin user management. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI providers ---
# Embeddings always use Gemini. Answers use LLM_PROVIDER.
GEMINI_API_KEY=
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_MODEL=gemini-2.5-flash
# gemini (default, free tier) | anthropic
LLM_PROVIDER=gemini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Set to 1 to use deterministic offline embeddings and canned answers (tests, CI, demos without keys).
MOCK_AI=0

# --- Retrieval tuning ---
# Minimum cosine similarity for the best chunk before the model is called at all.
MIN_SIMILARITY=0.55
MATCH_COUNT=8

# Shows one-click demo accounts on the login page.
NEXT_PUBLIC_DEMO_MODE=1
